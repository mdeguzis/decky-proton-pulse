{
  "_source": "https://github.com/mdeguzis/decky-proton-pulse/blob/main/src/lib/userConfigs.ts",
  "_note": "Canonical form schema for Pulse report submissions. Consumed by proton-pulse-data web app at build time.",
  "validRatings": ["platinum", "gold", "silver", "bronze", "borked"],
  "validOs": [
    "SteamOS",
    "Ubuntu",
    "Fedora",
    "Arch Linux",
    "Linux Mint",
    "Nobara",
    "Pop!_OS",
    "Manjaro",
    "openSUSE Tumbleweed",
    "Debian",
    "ChimeraOS",
    "Bazzite",
    "CachyOS",
    "EndeavourOS",
    "Garuda Linux",
    "NixOS"
  ],
  "validGpuVendors": ["nvidia", "amd", "intel", "other"],
  "validSources": ["user", "protondb", "protondb-local"],
  "protonVersionPattern": "^(Proton |GE-Proton|Proton-)\\d",
  "ramPattern": "^\\d+ GB$"
}
